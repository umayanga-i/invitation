# Browser-safe Supabase settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Used for absolute invitation URLs and auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional SQLite file location (defaults to ./data/dev.db)
INVITATION_DB_PATH=./data/dev.db
# Server only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only key for the email OTP Worker. Never use a NEXT_PUBLIC_ prefix.
OTP_API_KEY="replace-with-a-rotated-worker-api-key"
# ISO country code used when importing guest phone numbers
NEXT_PUBLIC_DEFAULT_PHONE_COUNTRY=LK
